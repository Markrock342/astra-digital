{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "astra",
  "main": "cloud/worker.mjs",
  "account_id": "ca63f6386985a309f86276da80b03111",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "COMMERCE",
        "class_name": "Commerce",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Commerce"],
    },
  ],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.sql"],
      "fallthrough": true,
    },
  ],
  // Client acceptance testing only. Delete before opening the real shop
  // (turns off test credit and test payments).
  "vars": {
    "ASTRA_TEST_PAYMENTS": "on",
    // Turnstile widget "asia-extra-shop" (domain astra-demo-133.pages.dev). The secret is a
    // Worker secret: npx wrangler secret put TURNSTILE_SECRET
    "TURNSTILE_SITE_KEY": "0x4AAAAAAF-jasVnNavNr3-A",
    // Cloudflare Email Sending (asiaextra.xyz onboarded in the dashboard).
    "EMAIL_FROM": "no-reply@asiaextra.xyz",
    "EMAIL_FROM_NAME": "ASIA EXTRA",
    // Links in emails (order page, password reset) always use the shop domain.
    "PUBLIC_BASE_URL": "https://asiaextra.xyz",
  },
  "send_email": [{ "name": "EMAIL" }],
  "observability": {
    "enabled": true,
  },
  // Email + Turnstile (docs/architecture/email-turnstile.md). All OFF until set by Mark:
  //   Email via Cloudflare Email Sending: onboard the sender domain, then uncomment
  //     "send_email": [{ "name": "EMAIL" }],
  //   and add "EMAIL_FROM": "no-reply@<your-domain>" (+ optional "EMAIL_FROM_NAME") to vars.
  //   Or via Resend: npx wrangler secret put RESEND_API_KEY, plus EMAIL_FROM in vars.
  //   Recommended: "PUBLIC_BASE_URL": "https://<shop domain>" in vars (links in emails).
  //   Turnstile: "TURNSTILE_SITE_KEY" in vars + npx wrangler secret put TURNSTILE_SECRET.
  //   EMAIL_API_BASE / TURNSTILE_VERIFY_URL are for local smoke tests only — never set them here.
  // Mark creates the bucket: npx wrangler r2 bucket create asiax-uploads
  // Then uncomment the block below (Nott must not create the bucket).
  // "r2_buckets": [
  //   {
  //     "binding": "UPLOADS",
  //     "bucket_name": "asiax-uploads",
  //   },
  // ],
  //
  // Automatic daily backup (docs/operations/backup.md). Off while this stays commented out.
  // Mark creates the bucket: npx wrangler r2 bucket create asiax-backups
  // Then add this entry to the same "r2_buckets" list as UPLOADS and deploy. The shop's
  // Durable Object alarm then writes backups/asiaextra-backup-*.json.gz once a day after
  // 04:00 Bangkok and deletes copies older than 14 days. No cron trigger is needed.
  //   {
  //     "binding": "BACKUPS",
  //     "bucket_name": "asiax-backups",
  //   },
}
