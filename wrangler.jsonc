{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "astra",
  "main": "cloud/worker.mjs",
  "account_id": "ca63f6386985a309f86276da80b03111",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "COMMERCE",
        "class_name": "Commerce",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Commerce"],
    },
  ],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.sql"],
      "fallthrough": true,
    },
  ],
  // Client acceptance testing only. Delete before opening the real shop
  // (turns off test credit and test payments).
  "vars": {
    "ASTRA_TEST_PAYMENTS": "on",
  },
  "observability": {
    "enabled": true,
  },
  // Mark creates the bucket: npx wrangler r2 bucket create asiax-uploads
  // Then uncomment the block below (Nott must not create the bucket).
  // "r2_buckets": [
  //   {
  //     "binding": "UPLOADS",
  //     "bucket_name": "asiax-uploads",
  //   },
  // ],
  //
  // Automatic daily backup (docs/operations/backup.md). Off while this stays commented out.
  // Mark creates the bucket: npx wrangler r2 bucket create asiax-backups
  // Then add this entry to the same "r2_buckets" list as UPLOADS and deploy. The shop's
  // Durable Object alarm then writes backups/asiaextra-backup-*.json.gz once a day after
  // 04:00 Bangkok and deletes copies older than 14 days. No cron trigger is needed.
  //   {
  //     "binding": "BACKUPS",
  //     "bucket_name": "asiax-backups",
  //   },
}
