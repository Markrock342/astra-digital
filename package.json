{
  "name": "astra-digital",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14"
  },
  "scripts": {
    "dev": "node server/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node server/local.mjs",
    "test": "node --test tests/commerce.test.mjs",
    "test:e2e": "playwright test",
    "seed": "node server/seed.mjs",
    "migrate": "node server/migrate.mjs",
    "cloud:dev": "wrangler dev --port 4332",
    "deploy": "npm run build && wrangler deploy",
    "cloud:check": "wrangler deploy --dry-run",
    "cloud:setup": "node scripts/init-cloud-dev.mjs",
    "qa:cloud": "node scripts/cloud-qa.mjs",
    "deploy:pages": "node scripts/deploy-pages.mjs"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "~5.9.2",
    "vite": "6.4.5",
    "wrangler": "4.156.0"
  }
}
